}

Table BEX_STORE_REVIEW {
  SRV_ID bigint [pk, increment]
  SRV_PUBLIC_ID char(32) [not null, unique]
  ORD_ID bigint [not null]
  STR_ID bigint [not null]
  PFL_ID bigint [not null]
  SRV_OVERALL_RATE int [not null]
  SRV_PRODUCT_MATCH_RATE int
  SRV_CONSERVATION_RATE int
  SRV_SERVICE_RATE int
  SRV_DELIVERY_RATE int
  SRV_PACKAGING_RATE int
  SRV_WOULD_BUY_AGAIN char(1)
  SRV_COMMENT varchar(2000)
  SRV_STORE_REPLY varchar(2000)
  SRV_STATUS varchar(20) [not null, default: 'ACTIVE']
  SRV_REVIEWED_AT timestamp [not null]
  SRV_CREATED_AT timestamp [not null]
  SRV_UPDATED_AT timestamp [not null]
  SRV_CREATED_BY bigint
  SRV_UPDATED_BY bigint

  indexes {
    (ORD_ID, STR_ID) [unique, name: 'UK_STORE_REVIEW_ORDER_STORE']
  }
}

Table BEX_BUSINESS_CONFIGURATION {
  BCF_ID bigint [pk, increment]
  BCF_PUBLIC_ID char(32) [not null, unique]
  BCF_CODE varchar(100) [not null, unique]
  BCF_MODULE varchar(50) [not null]
  BCF_NAME varchar(150) [not null]
  BCF_DESCRIPTION varchar(1000)
  BCF_VALUE_TEXT varchar(4000)
  BCF_VALUE_NUMBER decimal(19,6)
  BCF_VALUE_BOOLEAN char(1)
  BCF_UNIT varchar(50)
  BCF_STATUS varchar(20) [not null, default: 'ACTIVE']
  BCF_CREATED_AT timestamp [not null]
  BCF_UPDATED_AT timestamp [not null]
  BCF_CREATED_BY bigint
  BCF_UPDATED_BY bigint
}

Table BEX_NOTIFICATION_TEMPLATE {
  NTP_ID bigint [pk, increment]
  NTP_CODE varchar(100) [not null]
  NTP_CHANNEL varchar(20) [not null]
  NTP_TITLE varchar(200) [not null]
  NTP_BODY varchar(4000) [not null]
  NTP_STATUS varchar(20) [not null, default: 'ACTIVE']

  indexes {
    (NTP_CODE, NTP_CHANNEL) [unique, name: 'UK_NTP_CODE_CHANNEL']
  }
}

Table BEX_NOTIFICATION {
  NTF_ID bigint [pk, increment]
  NTF_PUBLIC_ID char(32) [not null, unique]
  PFL_ID bigint [not null]
  NTF_TYPE varchar(80) [not null]
  NTF_TITLE varchar(200) [not null]
  NTF_BODY varchar(2000) [not null]
  NTF_STATUS varchar(20) [not null, default: 'UNREAD']
  NTF_CREATED_AT timestamp [not null]
  NTF_READ_AT timestamp
}

Table BEX_NOTIFICATION_DELIVERY {
  NDL_ID bigint [pk, increment]
  NTF_ID bigint [not null]
  NDL_CHANNEL varchar(20) [not null]
  NDL_STATUS varchar(20) [not null, default: 'PENDING']
  NDL_ATTEMPTS int [not null, default: 0]
  NDL_SENT_AT timestamp

  indexes {
    (NTF_ID, NDL_CHANNEL) [unique, name: 'UK_NDL_CHANNEL']
  }
}

